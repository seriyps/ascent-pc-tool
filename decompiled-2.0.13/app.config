<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- 禁用所有DPI感知 -->
    <add key="DpiAwareness" value="unaware" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />
    <add key="DisableDpiAwareness" value="true" />
    <add key="SwStatus" value="company" />
    <!--industry  or   company-->
    <add key="realtimeout" value="300" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <runtime>
    <!-- 关键：禁用Windows Forms的DPI缩放功能 -->
    <AppContextSwitchOverrides value="             Switch.System.Windows.Forms.DoNotScaleForDpiChanges=true;             Switch.System.Windows.Forms.DoNotSupportActiveXControls=false;             Switch.System.Windows.Forms.DontSupportReentrantFilterMessage=true;             Switch.System.Windows.Forms.UseLegacyContextMenuStripSourceControlValue=false;             Switch.System.Windows.Forms.UseLegacyToolTipDisplay=false         " />
    <!-- 禁用.NET 4.7+的DPI改进功能 -->
    <AppContextSwitchOverrides value="Switch.System.Windows.Forms.ScaleTopLevelFormMinMaxSize=false" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="3rdLibs" />
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <!-- 对于.NET 4.7+，使用专门的配置节 -->
  <!--<System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="unaware" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />
    <add key="CheckedListBoxSupportImprovedScrolling" value="true" />
    <add key="DataGridViewUsesStartCellUnderMouseWhenScrollingScrollBars" value="true" />
    <add key="DisableDpiChangedMessageHandling" value="true" />
    <add key="EnableMultiMonitorDisplayClipping" value="true" />
    <add key="FormEnableVisualStylesBeforeDpiAwarenessInitialization" value="true" />
    <add key="MonthCalendarSizeFromClientArea" value="true" />
    <add key="RichTextBoxDisableAutoWordSelection" value="true" />
    <add key="ScaleTopLevelFormMinMaxSize" value="false" />
    <add key="ToolStripDisableDefaultEditorAlignment" value="true" />
    <add key="UseLegacyContextMenuStripSourceControlValue" value="true" />
    <add key="UseLegacyToolTipDisplay" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>-->
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>